# CSI habilitado en el driver WiFi
CONFIG_ESP_WIFI_CSI_ENABLED=y

# Sin agregación AMPDU: los paquetes agregados dan CSI poco fiable
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64

# Consola rápida: ~100 líneas de CSI por segundo en texto necesitan 921600 baudios
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_0=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

# CPU a 240 MHz y tick de 1 ms para que el ping a 100 Hz sea regular
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
